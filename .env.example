# Server
PORT=8080

# Shared LDAP settings
LDAP_BASE_DN=o=nycu

# Internal LDAP (student, employee, retire)
LDAP_INTERNAL_HOST=ldap-internal.nycu.edu.tw
LDAP_INTERNAL_PORT=636
LDAP_INTERNAL_USE_TLS=true
LDAP_INTERNAL_BIND_DN=cn=readonly,o=nycu
LDAP_INTERNAL_BIND_PW=your-internal-readonly-password
LDAP_INTERNAL_CONN_POOL_SIZE=10

# External LDAP (cooperator, alumni)
LDAP_EXTERNAL_HOST=ldap-external.nycu.edu.tw
LDAP_EXTERNAL_PORT=636
LDAP_EXTERNAL_USE_TLS=true
LDAP_EXTERNAL_BIND_DN=cn=readonly,o=nycu
LDAP_EXTERNAL_BIND_PW=your-external-readonly-password
LDAP_EXTERNAL_CONN_POOL_SIZE=5

# API Keys (format: key1:name1,key2:name2)
API_KEYS=your-api-key-here:portal,another-key:mfa

# Rate limiting (authenticate endpoint)
AUTH_RATE_LIMIT=5
AUTH_RATE_CLEANUP_MIN=10

# Password expiry window applied to LDAP entry's pwdChangedTime when building
# the authenticate response's password_state field. Empty or 0 disables the
# time-based check (pwdReset=TRUE → must_change still applies).
# Format: Go duration string (e.g. "8760h" for one year).
LDAP_PASSWORD_MAX_AGE=
