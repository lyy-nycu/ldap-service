# Docker Compose local environment
# Used by: docker compose up

PORT=8080

# Shared
LDAP_BASE_DN=dc=nycu

# Internal LDAP (docker container)
LDAP_INTERNAL_HOST=ldap-internal
LDAP_INTERNAL_PORT=636
LDAP_INTERNAL_USE_TLS=true
LDAP_INTERNAL_BIND_DN=cn=admin,dc=nycu
LDAP_INTERNAL_BIND_PW=adminpass
LDAP_INTERNAL_CONN_POOL_SIZE=3

# External LDAP (docker container)
LDAP_EXTERNAL_HOST=ldap-external
LDAP_EXTERNAL_PORT=636
LDAP_EXTERNAL_USE_TLS=true
LDAP_EXTERNAL_BIND_DN=cn=admin,dc=nycu
LDAP_EXTERNAL_BIND_PW=adminpass
LDAP_EXTERNAL_CONN_POOL_SIZE=3

# DEV/TEST ONLY: accept self-signed certs from the docker-compose openldap fixture.
# Never enable in production.
LDAP_TLS_INSECURE_SKIP_VERIFY=true

# API Keys
API_KEYS=test-api-key-001:integration-test

# Rate limiting
AUTH_RATE_LIMIT=5
AUTH_RATE_CLEANUP_MIN=10
